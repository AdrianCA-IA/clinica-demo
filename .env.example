# =============================================================================
# CLÍNICA DEMO — VARIABLES DE ENTORNO
# =============================================================================
# Copia este fichero a ".env" y rellena los valores reales.
# NUNCA subas el fichero ".env" al repositorio (está en .gitignore).
# Este fichero SÍ se puede subir — no contiene claves reales.
# =============================================================================


# -----------------------------------------------------------------------------
# OPENAI — Agente IA (chat + voz)
# -----------------------------------------------------------------------------
# Dónde conseguirla: platform.openai.com → API keys → "Create new secret key"
# Requisito: cuenta con acceso al modelo gpt-realtime-1.5 (Tier 1+)
OPENAI_API_KEY=sk-proj-...


# -----------------------------------------------------------------------------
# TWILIO — Llamadas de voz y SMS
# -----------------------------------------------------------------------------
# Dónde conseguirlo: console.twilio.com → Account Info (página principal)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# Número de Twilio desde el que llama/manda SMS el sistema
# Formato: +[código país][número], ej: +17627700780
# Dónde conseguirlo: console.twilio.com → Phone Numbers → Manage → Active numbers
TWILIO_PHONE_NUMBER=+1...

# URL pública del servidor (sin barra final)
# - En desarrollo: URL del túnel cloudflared (cambia en cada reinicio)
# - En producción: dominio o IP fija del servidor, ej: https://clinica.tudominio.com
# Configurar también en Twilio: Phone Numbers → tu número → Voice → Webhook → POST
# → https://TU_URL/calls/incoming
PUBLIC_URL=https://...


# -----------------------------------------------------------------------------
# GOOGLE CALENDAR — Sincronización de citas (opcional)
# -----------------------------------------------------------------------------
# Para configurar:
# 1. console.cloud.google.com → crear proyecto → habilitar "Google Calendar API"
# 2. IAM y administración → Cuentas de servicio → crear cuenta → descargar JSON
# 3. Abrir Google Calendar → ajustes del calendario → Compartir con personas
#    → añadir el email de la service account → permiso "Hacer cambios en eventos"
# 4. En ajustes del calendario → copiar el "ID del calendario" de abajo del todo

# Ruta al fichero JSON de credenciales de la Service Account
# (guárdalo fuera del repo o en una carpeta excluida por .gitignore)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json

# ID del calendario donde se crearán los eventos
# Ejemplos: "primary" (calendario principal) o "xxx@group.calendar.google.com"
GOOGLE_CALENDAR_ID=primary


# -----------------------------------------------------------------------------
# BASE DE DATOS (opcional — por defecto usa SQLite local)
# -----------------------------------------------------------------------------
# En desarrollo no hace falta configurar esto (usa clinica.db automáticamente).
# En producción se recomienda PostgreSQL.
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# DATABASE_URL=postgresql://clinica:password@localhost:5432/clinica_demo
